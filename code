function BuyerPortal() {
  const [mode, setMode] = useState("all"); // all | item | service
  const [q, setQ] = useState("");
  const [saved, setSaved] = useState([]);
  const [active, setActive] = useState(null);

  const listings = useMemo(() => {
    const needle = q.trim().toLowerCase();
    return MOCK_LISTINGS.filter((x) => {
      const typeOk = mode === "all" ? true : x.type === mode;
      const qOk = !needle
        ? true
        : [x.title, x.description, x.category, x.location]
            .join(" ")
            .toLowerCase()
            .includes(needle);
      return typeOk && qOk;
    });
  }, [mode, q]);

  function onSave(item) {
    setSaved((prev) => (prev.some((s) => s.id === item.id) ? prev : [...prev, item]));
  }

  return (
    <div>
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div className="text-sm font-semibold">Buyer view</div>
          <div className="text-xs text-muted-foreground">
            Browse listings and services. Arrange payment off-platform.
          </div>
        </div>
        <div className="flex flex-1 items-center gap-2 sm:justify-end">
          <div className="relative w-full max-w-md">
            <Search className="absolute left-3 top-2.5 h-4 w-4 text-muted-foreground" />
            <Input
              value={q}
              onChange={(e) => setQ(e.target.value)}
              placeholder="Search items, services, categories…"
              className="pl-9 rounded-xl"
            />
          </div>
          <Button variant="outline" className="rounded-xl" onClick={() => setMode((m) => (m === "all" ? "item" : m === "item" ? "service" : "all"))}>
            <Filter className="mr-2 h-4 w-4" />
            {mode === "all" ? "All" : mode === "item" ? "Buy/Sell" : "Services"}
          </Button>
        </div>
      </div>

      <div className="mt-5 grid gap-4 lg:grid-cols-3">
        <div className="lg:col-span-2 grid gap-4 sm:grid-cols-2">
          {listings.map((item) => (
            <ListingCard key={item.id} item={item} onOpen={setActive} onSave={onSave} />
          ))}
        </div>

        <Card className="rounded-2xl">
          <CardHeader>
            <CardTitle className="text-base">Saved</CardTitle>
            <CardDescription>Quick access to things you like.</CardDescription>
          </CardHeader>
          <CardContent className="space-y-2">
            {saved.length === 0 ? (
              <div className="text-sm text-muted-foreground">
                Save listings to see them here.
              </div>
            ) : (
              saved.map((s) => (
                <button
                  key={s.id}
                  className="w-full rounded-xl border px-3 py-2 text-left hover:bg-muted"
                  onClick={() => setActive(s)}
                >
                  <div className="flex items-center justify-between gap-2">
                    <div className="min-w-0">
                      <div className="truncate text-sm font-medium">{s.title}</div>
                      <div className="text-xs text-muted-foreground truncate">
                        {s.priceLabel} • {s.location}
                      </div>
                    </div>
                    <Badge variant="secondary" className="rounded-full">
                      {s.type === "service" ? "Service" : "Buy/Sell"}
                    </Badge>
                  </div>
                </button>
              ))
            )}

            <div className="pt-3">
              <div className="rounded-xl border bg-muted/30 p-3 text-xs text-muted-foreground">
                <span className="font-medium text-foreground">Reminder:</span> Payments do not happen in-app.
                Use chat to coordinate and meet safely.
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      {active ? (
        <div className="mt-6">
          <Card className="rounded-2xl">
            <CardHeader>
              <div className="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <CardTitle className="text-lg">{active.title}</CardTitle>
                  <CardDescription className="mt-1 flex flex-wrap items-center gap-2">
                    <Badge className="rounded-full">
                      {active.type === "service" ? "Service" : "Buy/Sell"}
                    </Badge>
                    <span className="inline-flex items-center gap-1">
                      <Tag className="h-3.5 w-3.5" /> {active.category}
                    </span>
                    <span className="inline-flex items-center gap-1">
                      <MapPin className="h-3.5 w-3.5" /> {active.location}
                    </span>
                  </CardDescription>
                </div>
                <div className="text-right">
                  <div className="text-lg font-semibold">{active.priceLabel}</div>
                  <div className="mt-1 inline-flex items-center gap-1 text-xs text-muted-foreground">
                    <Users className="h-3.5 w-3.5" /> Seller: {active.seller.name}
                  </div>
                </div>
              </div>
            </CardHeader>
            <CardContent className="space-y-4">
              <p className="text-sm text-muted-foreground">{active.description}</p>

              <div className="grid gap-3 md:grid-cols-2">
                <div className="rounded-2xl border p-4">
                  <div className="text-sm font-semibold">Message seller</div>
                  <div className="mt-1 text-xs text-muted-foreground">
                    Coordinate details here. Payment is off-platform.
                  </div>
                  <div className="mt-3 flex gap-2">
                    <Input className="rounded-xl" placeholder="Write a message…" />
                    <Button className="rounded-xl">
                      <Mail className="mr-2 h-4 w-4" /> Send
                    </Button>
                  </div>
                </div>
                <div className="rounded-2xl border p-4">
                  <div className="text-sm font-semibold">Safety tips</div>
                  <ul className="mt-2 space-y-2 text-xs text-muted-foreground">
                    <li>• Meet in a public place.</li>
                    <li>• Bring a friend if possible.</li>
                    <li>• Use in-app reporting for suspicious listings.</li>
                  </ul>
                </div>
              </div>

              <div className="flex flex-wrap gap-2">
                <Badge variant="secondary" className="rounded-full">
                  No in-app payments
                </Badge>
                <Badge variant="secondary" className="rounded-full">
                  Messaging supported
                </Badge>
              </div>
            </CardContent>
          </Card>
        </div>
      ) : null}
    </div>
  );
}

function SellerPortal() {
  const [tab, setTab] = useState("my");
  const [type, setType] = useState("item");
  const [title, setTitle] = useState("");
  const [desc, setDesc] = useState("");
  const [price, setPrice] = useState("");
  const [location, setLocation] = useState("");
  const [category, setCategory] = useState("");
  const [mine, setMine] = useState(MOCK_LISTINGS.slice(0, 2));

  const catOptions = type === "service" ? CONFIG.categories.services : CONFIG.categories.buySell;

  function submit() {
    if (!title.trim() || !price.trim()) return;
    const newItem = {
      id: String(Date.now()),
      type,
      title: title.trim(),
      description: desc.trim() || "(No description)",
      priceLabel: price.trim(),
      location: location.trim() || "(Not set)",
      category: category || catOptions[0],
      postedAt: "just now",
      seller: { name: "You", rating: 5.0 },
      tags: ["Off-app payment"],
    };
    setMine((prev) => [newItem, ...prev]);
    setTab("my");
    setTitle("");
    setDesc("");
    setPrice("");
    setLocation("");
    setCategory("");
  }

  return (
    <div className="grid gap-4 lg:grid-cols-3">
      <Card className="rounded-2xl lg:col-span-2">
        <CardHeader>
          <CardTitle className="text-base">Seller dashboard</CardTitle>
          <CardDescription>Post items or services. Manage inquiries.</CardDescription>
        </CardHeader>
        <CardContent>
          <Tabs value={tab} onValueChange={setTab}>
            <TabsList className="rounded-xl">
              <TabsTrigger value="my" className="rounded-xl">My listings</TabsTrigger>
              <TabsTrigger value="new" className="rounded-xl">New listing</TabsTrigger>
              <TabsTrigger value="inbox" className="rounded-xl">Inbox</TabsTrigger>
            </TabsList>

            <TabsContent value="my" className="mt-4">
              <div className="grid gap-3 sm:grid-cols-2">
                {mine.map((x) => (
                  <Card key={x.id} className="rounded-2xl">
                    <CardHeader className="pb-2">
                      <CardTitle className="text-sm">{x.title}</CardTitle>
                      <CardDescription className="flex items-center gap-2">
                        <Badge variant={x.type === "service" ? "secondary" : "outline"} className="rounded-full">
                          {x.type === "service" ? "Service" : "Buy/Sell"}
                        </Badge>
                        <span className="text-xs">{x.priceLabel}</span>
                      </CardDescription>
                    </CardHeader>
                    <CardContent className="pt-0">
                      <div className="text-xs text-muted-foreground">
                        {x.category} • {x.location}
                      </div>
                      <div className="mt-3 flex gap-2">
                        <Button variant="secondary" className="rounded-xl" size="sm">
                          Edit
                        </Button>
                        <Button variant="outline" className="rounded-xl" size="sm">
                          Archive
                        </Button>
                      </div>
                    </CardContent>
                  </Card>
                ))}
              </div>
            </TabsContent>

            <TabsContent value="new" className="mt-4">
              <div className="grid gap-3">
                <div className="grid gap-2 sm:grid-cols-2">
                  <div className="rounded-2xl border p-3">
                    <div className="text-xs font-medium text-muted-foreground">Listing type</div>
                    <div className="mt-2 flex gap-2">
                      <Button
                        variant={type === "item" ? "default" : "outline"}
                        className="rounded-xl"
                        onClick={() => setType("item")}
                      >
                        Buy/Sell
                      </Button>
                      <Button
                        variant={type === "service" ? "default" : "outline"}
                        className="rounded-xl"
                        onClick={() => setType("service")}
                      >
                        Services
                      </Button>
                    </div>
                    <div className="mt-2 text-xs text-muted-foreground">
                      Payments are not supported in-app.
                    </div>
                  </div>

                  <div className="rounded-2xl border p-3">
                    <div className="text-xs font-medium text-muted-foreground">Category</div>
                    <div className="mt-2 flex flex-wrap gap-2">
                      {catOptions.map((c) => (
                        <Badge
                          key={c}
                          variant={category === c ? "default" : "secondary"}
                          className="cursor-pointer rounded-full"
                          onClick={() => setCategory(c)}
                        >
                          {c}
                        </Badge>
                      ))}
                    </div>
                  </div>
                </div>

                <Input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Title" className="rounded-xl" />
                <Textarea value={desc} onChange={(e) => setDesc(e.target.value)} placeholder="Description" className="rounded-xl" />
                <div className="grid gap-3 sm:grid-cols-3">
                  <Input value={price} onChange={(e) => setPrice(e.target.value)} placeholder={type === "service" ? "$ / hr (ex: $45/hr)" : "Price (ex: $60)"} className="rounded-xl" />
                  <Input value={location} onChange={(e) => setLocation(e.target.value)} placeholder="Location / service area" className="rounded-xl" />
                  <Button className="rounded-xl" onClick={submit}>
                    <Plus className="mr-2 h-4 w-4" /> Publish
                  </Button>
                </div>
                <div className="text-xs text-muted-foreground">
                  Tip: add photos later when you wire storage (S3/R2).
                </div>
              </div>
            </TabsContent>

            <TabsContent value="inbox" className="mt-4">
              <div className="rounded-2xl border p-4">
                <div className="text-sm font-semibold">Messages (stub)</div>
                <div className="mt-1 text-xs text-muted-foreground">
                  This UI is ready to wire to real chat later.
                </div>
                <div className="mt-4 grid gap-2">
                  {["Buyer: Is this available?", "Buyer: Can you do Saturday?"].map((m, i) => (
                    <div key={i} className="rounded-xl border bg-muted/30 px-3 py-2 text-sm">
                      {m}
                    </div>
                  ))}
                </div>
              </div>
            </TabsContent>
          </Tabs>
        </CardContent>
      </Card>

      <Card className="rounded-2xl">
        <CardHeader>
          <CardTitle className="text-base">Seller checklist</CardTitle>
          <CardDescription>Simple rules that keep things smooth.</CardDescription>
        </CardHeader>
        <CardContent className="space-y-2 text-sm">
          <Pill>Be clear about meetup/service area</Pill>
          <Pill>State accepted payment methods</Pill>
          <Pill>Respond quickly to messages</Pill>
          <div className="rounded-2xl border p-3 text-xs text-muted-foreground">
            <span className="font-medium text-foreground">Note:</span> No payments in-app. Keep all payment details in chat and meet safely.
          </div>
        </CardContent>
      </Card>
    </div>
  );
}

